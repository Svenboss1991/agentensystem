# Nur als Vorlage. Echte Werte gehören in Netlify → Site configuration → Environment variables
# (lokal in .env, die nie eingecheckt wird).

# Frontend (öffentlich, durch RLS geschützt)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Serverseitig (geheim)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
AGENT_SECRET=            # lange Zufallszeichenkette, z. B. openssl rand -hex 32
# CLAUDE_MODEL=claude-opus-5-5

# Mail-Agent
MAIL_START_TAGE=3              # beim ersten Lauf so viele Tage zurück holen
MAIL_MAX_PRO_LAUF=50           # Mails pro Postfach und Lauf
MAIL_MAX_VERARBEITUNG=40       # Einordnungen pro Lauf
MAIL_ARCHIV_IM_POSTFACH=false  # true: Newsletter auch im Postfach ins Archiv verschieben

# OAuth-Apps (einmalig anlegen, siehe README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=

# Ein Eintrag pro Postfach, Name = MAIL_<accounts.secret_ref>_…
MAIL_HOSTPOINT_INFO_PASSWORD=
MAIL_HOSTINGER_INFO_PASSWORD=
MAIL_GMAIL_SVEN_REFRESH_TOKEN=
MAIL_HOTMAIL_SVEN_REFRESH_TOKEN=
