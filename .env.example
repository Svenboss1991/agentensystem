# Nur als Vorlage. Echte Werte gehören in Netlify → Site configuration → Environment variables
# (lokal in .env, die nie eingecheckt wird).

# Frontend (öffentlich, durch RLS geschützt)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Serverseitig (geheim)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Mail-Agent
MAIL_START_TAGE=3              # beim ersten Lauf so viele Tage zurück holen
MAIL_MAX_PRO_LAUF=20           # Mails pro Postfach und Lauf abholen
MAIL_PARALLEL=4                # Mails pro Lauf einordnen (ein Lauf hat max. 30 Sekunden)

MAIL_START_TAGE_GESENDET=14     # gesendete Mails beim ersten Mal so weit zurück (für Pendenzen)

# OAuth-Apps für Gmail/Hotmail (einmalig anlegen, siehe README). Verbunden wird über die Seite «Heute».
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Ein Eintrag pro Postfach, Name = MAIL_<accounts.secret_ref>_…
MAIL_HOSTPOINT_INFO_PASSWORD=
MAIL_HOSTINGER_INFO_PASSWORD=
